# Mythic supplies these settings to installed service containers.
RABBITMQ_HOST=mythic_rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=mythic_user
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=mythic_vhost
# RABBITMQ_URL may replace the individual connection settings.
# RABBITMQ_URL=amqp://user:password@127.0.0.1:5672/mythic_vhost
BEACONCRYPT_PROVIDER_NAME=beaconcrypt
BEACONCRYPT_RPC_TIMEOUT=20s
