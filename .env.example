# Export these values for local development; the program does not load .env.
BEACONCRYPT_PROVIDER_NAME=beaconcrypt
# Mythic installs inject the discrete RABBITMQ_* settings automatically.
RABBITMQ_URL=
BEACONCRYPT_NAMESPACE=beaconcrypt
# Prefix: each campaign uses server/campaign/<Mythic operation ID>.
BEACONCRYPT_STATE_ID=server
BEACONCRYPT_SERVER_KID=0
